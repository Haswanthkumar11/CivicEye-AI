# Application Environment & Network
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend-jc64-r7u81vqfy-haswanth1.vercel.app

# Security
SECRET_KEY=YOUR_NEW_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase Persistent Cloud Media Storage
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=civiceye-media

# Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
AI_ANALYSIS_ENABLED=true

# YOLO Road Damage Computer Vision
YOLO_MODEL_PATH=models/weights/road_damage_yolov8.onnx
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=cpu

# Whisper Speech Recognition
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local Media Directory & Limits
MEDIA_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Frontend (Configure in Vercel project environment settings)
VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com/api


# Frontend (Configure in Vercel project environment settings)
VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com/api