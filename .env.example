# ==============================================================================
# CivicEye AI - Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env in your root and backend directory.
# NEVER commit the actual .env file containing secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key for JWT / Session Tokens (Change in production!)
SECRET_KEY=civiceye_super_secret_jwt_key_replace_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / PostGIS / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civiceye_db
# For SQLite local fallback if PostgreSQL is not active:
# DATABASE_URL=sqlite:///./civiceye_local.db

# Supabase Integration (Optional if self-hosting Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=civiceye-media

# Google Gemini API (Multimodal AI Intelligence)
# Required for complaint understanding, extraction, multilingual interpretation, and triage
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Local Computer Vision (YOLO Road Damage Detection)
# FREE local model execution - No paid API
YOLO_MODEL_PATH=models/weights/road_damage_yolov8.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=cpu

# Local Voice Recognition (faster-whisper)
# FREE local speech recognition - Supports Telugu and English
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage Directory for Local Media (Fallback / Dev cache)
MEDIA_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Frontend Public API URL (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
